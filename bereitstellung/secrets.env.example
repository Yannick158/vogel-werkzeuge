# Kopiere diese Datei nach secrets.env und fülle sie aus.
# secrets.env wird von flash-sd.sh gelesen und ist NICHT für Git bestimmt.

# WLAN, in das der Pi soll (2,4 GHz oder 5 GHz, WPA2)
WIFI_SSID=""
WIFI_PASS=""
WIFI_COUNTRY="DE"

# Login für den Pi (SSH)
PI_HOSTNAME="birdnet"
PI_USER="vogel"
PI_PASS=""

# API-Keys (für später, nicht fürs Flashen nötig)
GEMINI_API_KEY=""
EBIRD_API_KEY=""
